# Copy to .env.local and fill in. Only PUBLIC values belong here — never the secret/service-role key.
# Supabase project URL and publishable (anon) key: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Optional: document-reading backend (defaults to the Render service in src/lib/extractApi.ts).
# NEXT_PUBLIC_EXTRACT_URL=https://studio5-bill-backened.onrender.com
